# ═══════════════════════════════════════════════════════════════════════════════
# Healthcare MCP Server - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env files with real keys to version control!
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────

# Port the server listens on (default: 3000)
PORT=3000

# Environment mode: "development" or "production"
# - development: Pretty-printed logs, detailed errors
# - production: JSON logs, minimal error exposure
NODE_ENV=development

# Log level: "trace", "debug", "info", "warn", "error", "fatal"
# - development: use "debug" or "info"
# - production: use "info" or "warn"
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────────
# AI CONFIGURATION (Required for chat functionality)
# ─────────────────────────────────────────────────────────────────────────────────

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Required for: AI chat interface, tool orchestration
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Redis Cache (for production scaling)
# ─────────────────────────────────────────────────────────────────────────────────
# Uncomment these if you want to use Redis for distributed caching
# The server works fine without Redis (uses in-memory cache)

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: External API Keys (if rate-limited)
# ─────────────────────────────────────────────────────────────────────────────────
# These APIs work without keys but have lower rate limits
# Register for free keys if you hit rate limits

# OpenFDA API Key (optional - increases rate limits)
# Register at: https://open.fda.gov/apis/authentication/
# OPENFDA_API_KEY=

# NCBI/PubMed API Key (optional - for guidelines search)
# Register at: https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=
